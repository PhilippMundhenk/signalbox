#!/bin/sh
# Signalbox integration test image (#137): first-boot setup, run once by /etc/init.d/boot
# after config_generate and "wifi config" and before any service starts.
#
#   eth0  management: 10.0.2.15/24 on QEMU's user-mode network (host port forward to 443)
#   eth1, eth2  ports of br-lan with VLAN filtering:
#         VLAN 1  "lan"  eth1 + eth2 untagged, 192.0.2.1/24, dnsmasq DHCP .100-.149
#                        handing out NTP 192.0.2.1 (option 42); sysntpd serves time on lan
#         VLAN 20 "iot"  eth2 tagged, 198.51.100.1/24, no DHCP
#   radio0 (2.4 GHz) and radio1 (5 GHz): SSID "Example-IT" (WPA2) on lan
#   radio2 (2.4 GHz): a station associated to that SSID (network "wwan", DHCP client), so
#         hostapd has a client and dnsmasq a lease
#   rpcd logins "signalbox" (read ACL) and "signalbox-write" (read + write ACL)
#   root's password for SSH (dropbear on every interface), for the automatic setup

# --- network --------------------------------------------------------------------------------
uci -q delete network.wan
uci -q delete network.wan6
uci -q delete network.lan
while uci -q delete network.@device[0]; do :; done
while uci -q delete network.@bridge-vlan[0]; do :; done

uci add network device >/dev/null
uci set network.@device[-1].name='br-lan'
uci set network.@device[-1].type='bridge'
uci add_list network.@device[-1].ports='eth1'
uci add_list network.@device[-1].ports='eth2'

uci add network bridge-vlan >/dev/null
uci set network.@bridge-vlan[-1].device='br-lan'
uci set network.@bridge-vlan[-1].vlan='1'
uci add_list network.@bridge-vlan[-1].ports='eth1:u*'
uci add_list network.@bridge-vlan[-1].ports='eth2:u*'

uci add network bridge-vlan >/dev/null
uci set network.@bridge-vlan[-1].device='br-lan'
uci set network.@bridge-vlan[-1].vlan='20'
uci add_list network.@bridge-vlan[-1].ports='eth2:t'

uci batch <<'EOF'
set network.mgmt=interface
set network.mgmt.device='eth0'
set network.mgmt.proto='static'
set network.mgmt.ipaddr='10.0.2.15'
set network.mgmt.netmask='255.255.255.0'
set network.mgmt.gateway='10.0.2.2'
add_list network.mgmt.dns='10.0.2.3'
set network.lan=interface
set network.lan.device='br-lan.1'
set network.lan.proto='static'
set network.lan.ipaddr='192.0.2.1'
set network.lan.netmask='255.255.255.0'
set network.iot=interface
set network.iot.device='br-lan.20'
set network.iot.proto='static'
set network.iot.ipaddr='198.51.100.1'
set network.iot.netmask='255.255.255.0'
set network.wwan=interface
set network.wwan.proto='dhcp'
set network.wwan.defaultroute='0'
set network.wwan.peerdns='0'
EOF

# --- WireGuard (#152): wg0 with one peer; the keys are made here, at first boot --------------
uci set network.wg0=interface
uci set network.wg0.proto='wireguard'
uci set network.wg0.private_key="$(wg genkey)"
uci set network.wg0.listen_port='51820'
uci add_list network.wg0.addresses='2001:db8:ff::1/64'
uci add network wireguard_wg0 >/dev/null
uci set network.@wireguard_wg0[-1].description='site-b'
uci set network.@wireguard_wg0[-1].public_key="$(wg genkey | wg pubkey)"
uci set network.@wireguard_wg0[-1].preshared_key="$(wg genpsk)"
uci set network.@wireguard_wg0[-1].endpoint_host='203.0.113.20'
uci set network.@wireguard_wg0[-1].endpoint_port='51820'
uci add_list network.@wireguard_wg0[-1].allowed_ips='2001:db8:ff::2/128'
uci add_list network.@wireguard_wg0[-1].allowed_ips='203.0.113.0/24'
uci set network.@wireguard_wg0[-1].persistent_keepalive='25'

# --- firewall: everything in the lan zone (the test only needs HTTPS on eth0) ----------------
for net in mgmt iot wwan; do uci add_list firewall.@zone[0].network="$net"; done

# --- DHCP -----------------------------------------------------------------------------------
uci -q delete dhcp.wan
uci set dhcp.lan.start='100'
uci set dhcp.lan.limit='50'
uci set dhcp.lan.leasetime='12h'
uci add_list dhcp.lan.dhcp_option='42,192.0.2.1'

# --- time (#179): Europe/Berlin as LuCI writes it, NTP server on lan ------------------------
uci set system.@system[0].zonename='Europe/Berlin'
uci set system.@system[0].timezone='CET-1CEST,M3.5.0,M10.5.0/3'
uci set system.ntp.enabled='1'
uci set system.ntp.enable_server='1'
uci set system.ntp.interface='lan'

# --- wireless (radios detected by "wifi config" from mac80211_hwsim, see /etc/modules.conf) --
for r in 0 1 2; do uci -q delete wireless.default_radio$r; done
for r in 0 1 2; do
  uci set wireless.radio$r.disabled='0'
  uci set wireless.radio$r.country='DE'
  uci set wireless.radio$r.htmode='HT20'
  uci set wireless.radio$r.band='2g'
  uci set wireless.radio$r.channel='1'
done
uci set wireless.radio1.band='5g'
uci set wireless.radio1.channel='36'
for r in 0 1; do
  uci batch <<EOF
set wireless.default_radio$r=wifi-iface
set wireless.default_radio$r.device='radio$r'
set wireless.default_radio$r.mode='ap'
set wireless.default_radio$r.network='lan'
set wireless.default_radio$r.ssid='Example-IT'
set wireless.default_radio$r.encryption='psk2'
set wireless.default_radio$r.key='example-it-passphrase'
set wireless.default_radio$r.ieee80211k='1'
set wireless.default_radio$r.bss_transition='1'
EOF
done
uci batch <<'EOF'
set wireless.station=wifi-iface
set wireless.station.device='radio2'
set wireless.station.mode='sta'
set wireless.station.network='wwan'
set wireless.station.ssid='Example-IT'
set wireless.station.encryption='psk2'
set wireless.station.key='example-it-passphrase'
EOF

# --- uhttpd: HTTPS with the px5g certificate made at first start, ubus at /ubus -------------
uci set uhttpd.main.ubus_prefix='/ubus'

# --- rpcd logins (ACL /usr/share/rpcd/acl.d/signalbox.json, from docs/adapters/openwrt.md) --
uci add rpcd login >/dev/null
uci set rpcd.@login[-1].username='signalbox'
uci set rpcd.@login[-1].password="$(uhttpd -m '@READ_PASSWORD@')"
uci add_list rpcd.@login[-1].read='signalbox'
uci add rpcd login >/dev/null
uci set rpcd.@login[-1].username='signalbox-write'
uci set rpcd.@login[-1].password="$(uhttpd -m '@WRITE_PASSWORD@')"
uci add_list rpcd.@login[-1].read='signalbox'
uci add_list rpcd.@login[-1].write='signalbox'

# --- SSH as root with a password (the automatic setup, #231), on every interface -----------
sed -i 's|^root:[^:]*:|root:@ROOT_HASH@:|' /etc/shadow
uci -q delete dropbear.@dropbear[0].Interface
uci set dropbear.@dropbear[0].PasswordAuth='on'
uci set dropbear.@dropbear[0].RootPasswordAuth='on'

uci commit
exit 0
